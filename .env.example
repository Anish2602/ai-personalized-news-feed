# ─────────────────────────────────────────────────────────────
# AI-Personalized News Feed — environment configuration
# Copy to .env and adjust. NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────

# --- Application ---
APP_NAME="AI Personalized News Feed"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Security (dev-oriented; JWT can be layered on later) ---
SECRET_KEY=change-me-in-production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- PostgreSQL ---
POSTGRES_USER=newsfeed
POSTGRES_PASSWORD=newsfeed
POSTGRES_DB=newsfeed
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy URL (psycopg3 driver, used for sync + async)
DATABASE_URL=postgresql+psycopg://newsfeed:newsfeed@postgres:5432/newsfeed
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=articles
QDRANT_VECTOR_SIZE=384            # must match the embedding model dimension

# --- Embeddings ---
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=2000            # article text is truncated to this before embedding

# --- LLM (OpenAI-compatible) ---
LLM_PROVIDER=openai
LLM_ENABLED=false                  # false -> keyword classification + extractive summary fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3                  # transport-level retries inside the SDK
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_OUTPUT_MAX_ATTEMPTS=2          # re-prompts on malformed/invalid JSON before failing the job

# --- News ingestion ---
NEWS_RSS_FEEDS=["https://feeds.arstechnica.com/arstechnica/index","https://www.theverge.com/rss/index.xml","https://hnrss.org/frontpage"]
NEWS_API_ENABLED=false
NEWS_API_KEY=
INGEST_MAX_ARTICLES_PER_FEED=50
INGEST_HTTP_TIMEOUT_SECONDS=15
INGEST_INTERVAL_MINUTES=30          # Celery beat cadence for automatic ingestion

# --- Deduplication ---
SEMANTIC_DUPLICATE_THRESHOLD=0.90   # configurable; evaluate against real data
DEDUP_TOP_K=10

# --- Topic taxonomy ---
TOPIC_TAXONOMY=["Artificial Intelligence","Software Engineering","Cloud","Cybersecurity","Startups","Business","Finance","Science","Technology","Politics","World","Sports","Entertainment"]

# --- Interaction weights (tunable, not hardcoded) ---
INTERACTION_WEIGHT_VIEW=1
INTERACTION_WEIGHT_CLICK=2
INTERACTION_WEIGHT_LIKE=3
INTERACTION_WEIGHT_SAVE=4
INTERACTION_WEIGHT_SHARE=4
INTERACTION_WEIGHT_SKIP=-1
INTERACTION_WEIGHT_DISLIKE=-4

# --- Ranking weights (must sum to ~1.0) ---
RANK_WEIGHT_SEMANTIC=0.55
RANK_WEIGHT_FRESHNESS=0.20
RANK_WEIGHT_POPULARITY=0.10
RANK_WEIGHT_SOURCE_QUALITY=0.10
RANK_WEIGHT_DIVERSITY=0.05
FRESHNESS_DECAY_HOURS=24
FEED_DEFAULT_LIMIT=20
FEED_MAX_LIMIT=50
FEED_CANDIDATE_POOL=200

# --- Feed cache ---
FEED_CACHE_TTL_SECONDS=300

# --- Celery task policy ---
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=10
